# Copy this file to .env and fill in your values
# .env is NOT committed to git (see .gitignore)

# Path to fresh miniflux source (git clone https://github.com/miniflux/v2.git)
MINIFLUX_DIR="$HOME/Desktop/miniflux"

# Docker image tag — use GitHub Container Registry
# Format: ghcr.io/<github-username>/<repo-name>:latest
DOCKER_IMAGE="ghcr.io/ctrl-i/miniflux-with-descriptions:latest"

# Target platform
DOCKER_PLATFORM="linux/arm64/v8"

# Push after build? (true/false)
PUSH="true"
